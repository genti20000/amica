{
  "framework": "vite",
  "buildCommand": "npm run lint && npm run build",
  "outputDirectory": "dist",
  "regions": [
    "lhr1"
  ],
  "rewrites": [
    {
      "source": "/api/careers/apply",
      "destination": "/api/careers"
    },
    {
      "source": "/careers",
      "destination": "/careers/index.html"
    },
    {
      "source": "/careers/",
      "destination": "/careers/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "npm ci"
}
