{
  "framework": "vite",
  "buildCommand": "npm run lint && npm run build",
  "outputDirectory": "dist",
  "regions": [
    "lhr1"
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/pre-theatre",
      "destination": "/pre-theatre/index.html"
    },
    {
      "source": "/karaoke-food-drinks",
      "destination": "/karaoke-food-drinks/index.html"
    },
    {
      "source": "/karaoke-food-drinks/",
      "destination": "/karaoke-food-drinks/index.html"
    },
    {
      "source": "/((?!assets/|pre-theatre/|karaoke-food-drinks/).*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "npm ci"
}
