{
  "framework": "vite",
  "buildCommand": "npm run lint && npm run build && npm run recover:membership",
  "outputDirectory": "dist",
  "regions": [
    "lhr1"
  ],
  "rewrites": [
    {
      "source": "/pass",
      "has": [
        {
          "type": "host",
          "value": "members.amicasoho.com"
        }
      ],
      "destination": "/membership/pass/index.html"
    },
    {
      "source": "/api/membership/pass/view",
      "destination": "/api/membership-pass"
    },
    {
      "source": "/membership/pass",
      "destination": "/membership/pass/index.html"
    },
    {
      "source": "/membership/pass/",
      "destination": "/membership/pass/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "members.amicasoho.com"
        }
      ],
      "destination": "/membership/index.html"
    },
    {
      "source": "/register",
      "has": [
        {
          "type": "host",
          "value": "members.amicasoho.com"
        }
      ],
      "destination": "/membership/index.html"
    },
    {
      "source": "/rules",
      "has": [
        {
          "type": "host",
          "value": "members.amicasoho.com"
        }
      ],
      "destination": "/membership/rules/index.html"
    },
    {
      "source": "/privacy",
      "has": [
        {
          "type": "host",
          "value": "members.amicasoho.com"
        }
      ],
      "destination": "/membership/privacy/index.html"
    },
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "members.amicasoho.com"
        }
      ],
      "destination": "/membership/admin/index.html"
    },
    {
      "source": "/api/membership/apply",
      "destination": "/api/membership"
    },
    {
      "source": "/membership",
      "destination": "/membership/index.html"
    },
    {
      "source": "/membership/",
      "destination": "/membership/index.html"
    },
    {
      "source": "/membership/rules",
      "destination": "/membership/rules/index.html"
    },
    {
      "source": "/membership/rules/",
      "destination": "/membership/rules/index.html"
    },
    {
      "source": "/membership/privacy",
      "destination": "/membership/privacy/index.html"
    },
    {
      "source": "/membership/privacy/",
      "destination": "/membership/privacy/index.html"
    },
    {
      "source": "/membership/admin",
      "destination": "/membership/admin/index.html"
    },
    {
      "source": "/membership/admin/",
      "destination": "/membership/admin/index.html"
    },
    {
      "source": "/api/careers/apply",
      "destination": "/api/careers"
    },
    {
      "source": "/careers/bar-staff",
      "destination": "/careers/bar-staff/index.html"
    },
    {
      "source": "/careers/bar-staff/",
      "destination": "/careers/bar-staff/index.html"
    },
    {
      "source": "/careers/floor-staff",
      "destination": "/careers/floor-staff/index.html"
    },
    {
      "source": "/careers/floor-staff/",
      "destination": "/careers/floor-staff/index.html"
    },
    {
      "source": "/careers",
      "destination": "/careers/index.html"
    },
    {
      "source": "/careers/",
      "destination": "/careers/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "npm ci",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "members.amicasoho.com"
        }
      ],
      "destination": "/register",
      "permanent": false
    }
  ]
}
